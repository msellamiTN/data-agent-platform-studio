# Optional native-provider integrations. Store actual values in Colab Secrets or a local .env.
# Never commit credentials.

# Databricks Genie Agent (Unity Catalog data assets must already be configured)
DATABRICKS_HOST=https://<your-workspace-host>
DATABRICKS_TOKEN=
DATABRICKS_GENIE_SPACE_ID=

# Snowflake Cortex Agent (agent object and tools must already be configured)
SNOWFLAKE_HOST=<account>.snowflakecomputing.com
SNOWFLAKE_TOKEN=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_AGENT_NAME=

# Independent local model configuration
HF_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
HF_MAX_NEW_TOKENS=384
MAX_UPLOAD_MB=25
