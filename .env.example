# Local model and runtime controls only. No external agent-provider credentials.
HF_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
HF_DEVICE=auto
# Set HF_DEVICE=cpu to force CPU, or HF_DEVICE=cuda to require CUDA.
HF_CPU_THREADS=4
HF_MAX_NEW_TOKENS=384
MAX_UPLOAD_MB=25
MAX_DATA_ROWS=250000
MAX_DATA_COLUMNS=250
MAX_COLUMN_NAME_CHARS=128
MAX_SAMPLE_VALUE_CHARS=160
MAX_BUSINESS_CONTEXT_CHARS=4000
MAX_ANALYSIS_QUESTION_CHARS=2000
MAX_SQL_EXECUTION_SECONDS=5
MAX_SQL_CELL_CHARS=1024
MAX_SQL_RESULT_BYTES=524288
